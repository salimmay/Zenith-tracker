---
// The app icon, inline so it stays crisp and costs no request.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 120 120" fill="none" aria-hidden="true">
  <rect width="120" height="120" rx="28" fill="#161B1B"></rect>
  <circle cx="60" cy="60" r="46" stroke="#1C3B38" stroke-width="4"></circle>
  <path d="M40 38H80L44 82H84" stroke="#80CBC4" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="82" cy="38" r="4.5" fill="#F2B45C"></circle>
</svg>
