---
// Five small reasons to try Zenith. Icons are inline 24px strokes.
const items = [
  {
    title: 'TV, movies and anime',
    body: 'One library for everything, with seasons, specials and runtimes from TMDB.',
    icon: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  },
  {
    title: 'No account needed',
    body: 'Start tracking in seconds. Sign up later and your library comes with you.',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  },
  {
    title: 'Trakt sync',
    body: 'Connect Trakt and your watches flow both ways, without duplicate plays.',
    icon: '<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>',
  },
  {
    title: 'Works offline',
    body: 'Your shows load instantly from the device and catch up when you are back online.',
    icon: '<path d="M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1"/>',
  },
  {
    title: 'Easy on the eyes',
    body: 'A calm dark design made for late-night episodes, with smooth, quick motion.',
    icon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>',
  },
];
---

<section class="highlights" aria-labelledby="highlights-title">
  <h2 id="highlights-title" class="visually-hidden">More reasons to try Zenith</h2>
  <ul class="grid">
    {
      items.map((item, i) => (
        <li class="tile" data-highlight data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={item.icon}
          />
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  svg {
    width: 36px;
    height: 36px;
    padding: 7px;
    margin-bottom: 6px;
    border-radius: 10px;
    background: var(--teal-soft);
    color: var(--teal);
  }
  h3 {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  p {
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.5;
  }
</style>
