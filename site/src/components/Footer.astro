---
import Logo from './Logo.astro';
import { site } from '../site.config.ts';
---

<footer class="footer">
  <div class="container inner">
    <div class="top">
      <a class="brand" href="/" aria-label="Zenith home">
        <Logo size={24} />
        <span>Zenith</span>
      </a>
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/support">Support</a>
        {site.supportEmail && <a href={`mailto:${site.supportEmail}`}>Contact</a>}
      </nav>
    </div>
    <p class="tmdb">
      <a href="https://www.themoviedb.org" rel="noopener">TMDB</a>
      <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
    </p>
    <p class="copy">© {new Date().getFullYear()} Salim May</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 96px;
    border-top: 1px solid var(--border);
    padding-block: 40px calc(40px + env(safe-area-inset-bottom));
    color: var(--text-faint);
    font-size: 14px;
  }
  .inner {
    display: grid;
    gap: 20px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 20px;
  }
  nav a {
    color: var(--text-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
  .tmdb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .tmdb a {
    padding: 2px 8px;
    border-radius: 6px;
    background: linear-gradient(90deg, #90cea1, #01b4e4);
    color: #0d253f;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
</style>
