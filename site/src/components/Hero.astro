---
import PhoneFrame from './PhoneFrame.astro';
import PlayButton from './PlayButton.astro';
---

<section class="hero">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">TV · Movies · Anime</p>
      <h1>Never lose your place in a show again.</h1>
      <p class="lede">
        Zenith remembers the next episode of everything you watch, tells you when new ones air, and shows how
        your watching adds up. No account needed.
      </p>
      <div class="actions">
        <PlayButton />
        <span class="note">Free · Android</span>
      </div>
    </div>
    <div class="visual">
      <div class="glow" aria-hidden="true"></div>
      <PhoneFrame src="/screens/library.webp" alt="Zenith's library: a grid of show posters with watch progress" eager />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 56px 32px;
    overflow-x: clip; /* the glow bleeds wider than the screen */
  }
  .grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 88px 48px;
    }
    .grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }
  .copy {
    display: grid;
    gap: 20px;
    max-width: 580px;
  }
  h1 {
    font-size: clamp(38px, 7vw, 64px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .lede {
    font-size: clamp(17px, 2vw, 19px);
    color: var(--text-muted);
    max-width: 52ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 8px;
  }
  .note {
    color: var(--text-faint);
    font-size: 14px;
  }
  .visual {
    position: relative;
    display: grid;
    place-items: center;
    animation: rise 900ms var(--ease-out) both;
  }
  .glow {
    position: absolute;
    inset: -10% -20%;
    background:
      radial-gradient(closest-side, rgba(128, 203, 196, 0.22), transparent 70%),
      radial-gradient(closest-side at 70% 30%, rgba(242, 180, 92, 0.08), transparent 70%);
    filter: blur(8px);
    pointer-events: none;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
