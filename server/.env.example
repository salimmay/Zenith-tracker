PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zenith
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional — enables "Connect Trakt". Create an app at https://trakt.tv/oauth/applications
# with redirect uri: urn:ietf:wg:oauth:2.0:oob
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Set to false to hide every ad slot in the apps without shipping an update.
ADS_ENABLED=true
# Comma-separated browser origins allowed in production (e.g. the Expo web build).
# Native iOS/Android apps need nothing here.
CORS_ORIGINS=
